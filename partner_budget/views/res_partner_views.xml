<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_form_budget" model="ir.ui.view">
        <field name="name">res.partner.form.budget</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_partner_invoices" icon="fa-usd">
                    <field name="invoiced_amount" widget="statinfo" string="Invoiced (Year)"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_view_partner_pipeline" icon="fa-line-chart">
                    <field name="pipeline_expected_revenue" widget="statinfo" string="Pipeline"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_view_partner_backlog" icon="fa-clock-o">
                    <field name="invoice_backlog_amount" widget="statinfo" string="Backlog"/>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Budget" name="partner_budget">
                    <group>
                        <group string="This Year">
                            <field name="company_currency_id" invisible="1"/>
                            <field name="budget_amount"/>
                            <field name="confirmed_orders_amount"/>
                            <field name="invoiced_amount"/>
                            <field name="budget_achieved_pct" widget="percentage"/>
                            <field name="budget_remaining"/>
                        </group>
                        <group string="Pipeline &amp; Backlog">
                            <field name="pipeline_expected_revenue"/>
                            <field name="pipeline_weighted_revenue"/>
                            <field name="invoice_backlog_amount"/>
                        </group>
                    </group>
                    <separator string="Budget by Year / Company"/>
                    <field name="budget_ids">
                        <list editable="bottom">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="year"/>
                            <field name="eur_currency_id" column_invisible="1"/>
                            <field name="budget_amount_eur" string="Budget"/>
                            <field name="confirmed_orders_amount_eur" string="Confirmed Orders"/>
                            <field name="invoiced_amount_eur" string="Invoiced"/>
                            <field name="budget_achieved_pct" widget="percentage"/>
                            <field name="remaining_amount_eur" string="Remaining"/>
                            <field name="notes" optional="hide"/>
                            <button name="action_refresh" type="object"
                                    string="Refresh" icon="fa-refresh"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <record id="res_partner_budget_overview_tree" model="ir.ui.view">
        <field name="name">res.partner.budget.overview.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Partner Budget Overview" create="0" delete="0" default_order="budget_achieved_pct desc">
                <field name="name"/>
                <field name="company_currency_id" invisible="1"/>
                <field name="budget_amount" sum="Total"/>
                <field name="confirmed_orders_amount" sum="Total"/>
                <field name="invoiced_amount" sum="Total"/>
                <field name="budget_achieved_pct" widget="percentage"/>
                <field name="budget_remaining" sum="Total"/>
                <field name="pipeline_expected_revenue" sum="Total"/>
                <field name="pipeline_weighted_revenue" sum="Total"/>
                <field name="invoice_backlog_amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="res_partner_budget_overview_action" model="ir.actions.act_window">
        <field name="name">Partner Budgets</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="res_partner_budget_overview_tree"/>
        <field name="domain">[('customer_rank', '&gt;', 0)]</field>
    </record>

    <menuitem id="res_partner_budget_overview_menu"
              name="Partner Budgets"
              parent="sale.sale_menu_root"
              action="res_partner_budget_overview_action"
              sequence="90"/>

</odoo>
