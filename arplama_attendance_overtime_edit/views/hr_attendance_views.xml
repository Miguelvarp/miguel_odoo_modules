<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone override so it survives updates of arplama_custom_test,
         whose view_hr_attendance_tree_inherit kept dropping this xpath. -->
    <record id="view_attendance_tree_overtime_editable" model="ir.ui.view">
        <field name="name">hr.attendance.list.overtime.editable</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="editable">bottom</attribute>
                <attribute name="multi_edit">1</attribute>
            </xpath>
            <xpath expr="//field[@name='overtime_hours']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
        </field>
    </record>
</odoo>
