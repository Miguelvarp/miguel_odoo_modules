<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_form_call_outcome" model="ir.ui.view">
        <field name="name">crm.lead.form.call.outcome</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- "Log call" button next to the phone number.
                 The form has two phone fields in type-conditional blocks:
                 the opportunity layout (no id) and the lead layout
                 (id="phone_group_lead_info"). Add the button after both. -->
            <xpath expr="//field[@name='phone'][not(@id)]" position="after">
                <button name="%(action_crm_call_outcome_wizard)s"
                        type="action"
                        string="Log call"
                        icon="fa-phone"
                        class="btn-link"
                        invisible="not phone"/>
            </xpath>

            <xpath expr="//field[@id='phone_group_lead_info']" position="after">
                <button name="%(action_crm_call_outcome_wizard)s"
                        type="action"
                        string="Log call"
                        icon="fa-phone"
                        class="btn-link"
                        invisible="not phone"/>
            </xpath>

            <!-- "Calls" stat button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_call_outcomes" icon="fa-phone"
                        invisible="call_outcome_count == 0">
                    <field name="call_outcome_count" widget="statinfo" string="Calls"/>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
