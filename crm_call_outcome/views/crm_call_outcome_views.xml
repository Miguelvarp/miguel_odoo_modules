<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_call_outcome_view_list" model="ir.ui.view">
        <field name="name">crm.call.outcome.list</field>
        <field name="model">crm.call.outcome</field>
        <field name="arch" type="xml">
            <list string="Call Outcomes">
                <field name="call_date"/>
                <field name="lead_id"/>
                <field name="partner_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="call_status"/>
                <field name="disposition"/>
                <field name="team_id" optional="hide"/>
                <field name="stage_id" optional="hide"/>
                <field name="feedback" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="crm_call_outcome_view_form" model="ir.ui.view">
        <field name="name">crm.call.outcome.form</field>
        <field name="model">crm.call.outcome</field>
        <field name="arch" type="xml">
            <form string="Call Outcome">
                <sheet>
                    <group>
                        <group>
                            <field name="lead_id"/>
                            <field name="partner_id"/>
                            <field name="user_id"/>
                            <field name="call_date"/>
                        </group>
                        <group>
                            <field name="call_status"/>
                            <field name="disposition"/>
                            <field name="team_id"/>
                            <field name="stage_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Feedback">
                        <field name="feedback" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="crm_call_outcome_view_search" model="ir.ui.view">
        <field name="name">crm.call.outcome.search</field>
        <field name="model">crm.call.outcome</field>
        <field name="arch" type="xml">
            <search string="Call Outcomes">
                <field name="lead_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="feedback"/>
                <filter name="my_calls" string="My Calls"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="connected" string="Connected"
                        domain="[('call_status', '=', 'connected')]"/>
                <filter name="voicemail" string="Voice mail"
                        domain="[('call_status', '=', 'voicemail')]"/>
                <separator/>
                <filter name="callback" string="Call-back requested"
                        domain="[('disposition', '=', 'callback_requested')]"/>
                <filter name="not_interested" string="Not interested"
                        domain="[('disposition', '=', 'not_interested')]"/>
                <separator/>
                <filter name="this_week" string="This Week"
                        domain="[('call_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="This Month"
                        domain="[('call_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter name="group_user" string="Caller"
                        context="{'group_by': 'user_id'}"/>
                <filter name="group_status" string="Call status"
                        context="{'group_by': 'call_status'}"/>
                <filter name="group_disposition" string="Outcome"
                        context="{'group_by': 'disposition'}"/>
                <filter name="group_team" string="Sales Team"
                        context="{'group_by': 'team_id'}"/>
                <filter name="group_stage" string="Stage"
                        context="{'group_by': 'stage_id'}"/>
                <filter name="group_date" string="Call Date"
                        context="{'group_by': 'call_date:week'}"/>
            </search>
        </field>
    </record>

    <record id="crm_call_outcome_view_pivot" model="ir.ui.view">
        <field name="name">crm.call.outcome.pivot</field>
        <field name="model">crm.call.outcome</field>
        <field name="arch" type="xml">
            <pivot string="Call Outcomes" sample="1">
                <field name="user_id" type="row"/>
                <field name="disposition" type="col"/>
                <field name="call_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="crm_call_outcome_view_graph" model="ir.ui.view">
        <field name="name">crm.call.outcome.graph</field>
        <field name="model">crm.call.outcome</field>
        <field name="arch" type="xml">
            <graph string="Call Outcomes" sample="1" type="bar">
                <field name="user_id"/>
                <field name="disposition"/>
                <field name="call_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="crm_call_outcome_action" model="ir.actions.act_window">
        <field name="name">Call Outcomes</field>
        <field name="res_model">crm.call.outcome</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="search_view_id" ref="crm_call_outcome_view_search"/>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_user': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">No calls logged yet</p>
            <p>Call outcomes logged from a lead or opportunity show up here.</p>
        </field>
    </record>

    <menuitem id="crm_call_outcome_menu"
              name="Call Outcomes"
              parent="crm.crm_menu_report"
              action="crm_call_outcome_action"
              sequence="25"/>

</odoo>
