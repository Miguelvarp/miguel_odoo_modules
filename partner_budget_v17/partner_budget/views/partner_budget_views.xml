<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="partner_budget_view_tree" model="ir.ui.view">
        <field name="name">partner.budget.tree</field>
        <field name="model">partner.budget</field>
        <field name="arch" type="xml">
            <tree string="Budget Lines" editable="bottom">
                <header>
                    <button name="action_refresh_invoiced" type="object"
                            string="Refresh Invoiced" icon="fa-refresh"/>
                </header>
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="year"/>
                <field name="budget_amount" sum="Total"/>
                <field name="invoiced_amount" sum="Total"/>
                <field name="budget_achieved_pct" widget="percentage"/>
                <field name="remaining_amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="notes" optional="hide"/>
                <button name="action_refresh_invoiced" type="object"
                        string="Refresh" icon="fa-refresh"/>
            </tree>
        </field>
    </record>

    <record id="partner_budget_view_form" model="ir.ui.view">
        <field name="name">partner.budget.form</field>
        <field name="model">partner.budget</field>
        <field name="arch" type="xml">
            <form string="Budget Line">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_refresh_invoiced" icon="fa-refresh">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Refresh</span>
                                <span class="o_stat_text">Invoiced</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="year"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="budget_amount"/>
                            <field name="invoiced_amount"/>
                            <field name="budget_achieved_pct" widget="percentage"/>
                            <field name="remaining_amount"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partner_budget_action" model="ir.actions.act_window">
        <field name="name">Budget Lines</field>
        <field name="res_model">partner.budget</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">No budget lines yet</p>
            <p>
                Add one customer at a time here, or use the "Favorites &gt; Import
                records" button above to bulk-load budgets for every customer at
                once from an Excel/CSV file (Odoo's Import wizard can generate a
                blank template for you with the right column headers).
            </p>
        </field>
    </record>

    <menuitem id="partner_budget_menu"
              name="Budget Lines"
              parent="sale.sale_menu_root"
              action="partner_budget_action"
              sequence="91"/>

</odoo>
